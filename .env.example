# ==============================================================================
# IT Club Recruitment — Environment Variables Template
# Copy this file to .env.local and populate with your real secrets.
# NEVER commit .env.local or real credentials to source control.
# ==============================================================================

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
# Server-side / GitHub Actions public API key for health check (never use service_role)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Base URL (Used for activation links and OAuth redirects)
# In development: http://localhost:3000
# In production: https://dev.itclub.one
APP_BASE_URL=https://dev.itclub.one

# Direct Gmail SMTP Configuration (Temporary personal sender account)
# Use a 16-character Google App Password (NOT your normal Google account password).
# Prerequisites in Google Account: 2-Step Verification enabled -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=seif.tanjiro@gmail.com
GMAIL_APP_PASSWORD=SET_THIS_IN_VERCEL_ENVIRONMENT_VARIABLES
EMAIL_FROM=IT Club Recruitment <seif.tanjiro@gmail.com>

# Optional SMTP Settings (defaults to smtp.gmail.com and port 465 SSL/TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Email Delivery Mode
# EMAIL_DELIVERY_MODE: 'sync' (default, immediate delivery via SMTP) or 'outbox' (queued in database)
# When 'outbox' is used, set OUTBOX_WORKER_ENABLED=true and ensure a cron runner (e.g. Vercel Cron via vercel.json)
# invokes /api/admin/notifications/process with CRON_SECRET to process pending emails.
EMAIL_DELIVERY_MODE=sync
OUTBOX_WORKER_ENABLED=false
# Maximum milliseconds to wait for SMTP dispatch before continuing
EMAIL_DISPATCH_TIMEOUT_MS=3500

# Upstash Redis Distributed Rate Limiting (Server-only)
# Used to replace database rate-limiting with high-throughput sliding-window limits.
# Obtain from Upstash Console: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Rate Limiting Configuration & Fallback Policy
# Fallback when Redis is unavailable: 'memory' (default instance-local) | 'fail_open' | 'db'
RATE_LIMIT_FALLBACK_MODE=memory
# Maximum timeout for Upstash Redis operations before falling back
RATE_LIMIT_TIMEOUT_MS=1000
# Maximum registration submissions per client IP (higher for campus Wi-Fi NAT gateways)
RATE_LIMIT_IP_MAX=60
# Maximum registration submissions per university email
RATE_LIMIT_EMAIL_MAX=3

# Cron Worker Authentication
# Used to secure /api/admin/notifications/process for external cron triggers
CRON_SECRET=your_secure_random_cron_secret_here
